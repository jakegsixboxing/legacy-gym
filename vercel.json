{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/book-pt-jake",
      "destination": "/pt-jake"
    },
    {
      "source": "/book-pt-joe",
      "destination": "/pt-joe"
    },
    {
      "source": "/book-pt-sarsha",
      "destination": "/pt-sarsha"
    },
    {
      "source": "/coaches-jake",
      "destination": "/pt-jake"
    },
    {
      "source": "/coaches-joe",
      "destination": "/pt-joe"
    },
    {
      "source": "/coaches-sarsha",
      "destination": "/pt-sarsha"
    },
    {
      "source": "/alison-preview",
      "destination": "/alison"
    },
    {
      "source": "/book-pt-alison",
      "destination": "/pt-alison"
    },
    {
      "source": "/coaches-alison",
      "destination": "/pt-alison"
    }
  ],
  "rewrites": [
    {
      "source": "/api/fn-ticket-email",
      "destination": "/api/fightnight?a=ticket-email"
    },
    {
      "source": "/fightnight/:slug",
      "destination": "/api/fightnight?a=share&f=:slug"
    }
  ]
}
