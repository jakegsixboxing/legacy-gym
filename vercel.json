{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/book-pt-jake",
      "destination": "/pt-jake"
    },
    {
      "source": "/book-pt-joe",
      "destination": "/pt-joe"
    },
    {
      "source": "/book-pt-sarsha",
      "destination": "/pt-sarsha"
    },
    {
      "source": "/coaches-jake",
      "destination": "/pt-jake"
    },
    {
      "source": "/coaches-joe",
      "destination": "/pt-joe"
    },
    {
      "source": "/coaches-sarsha",
      "destination": "/pt-sarsha"
    }
  ]
}